# Yebunna OS runs every agent through the Claude Code CLI (`claude -p`), which
# uses your Claude Pro/Max subscription. Install Claude Code and run `claude`
# once to log in — no API key needed.

# Model alias or id passed to `claude --model` (e.g. opus, sonnet, haiku).
# Leave empty to use your Claude Code default.
CLAUDE_MODEL=
# Only if auto-detection fails: full path to Claude Code, e.g.
# CLAUDE_BIN=C:\Users\you\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe

PORT=3000
# How many agents may work at the same time (each is a separate claude process).
MAX_PARALLEL_TASKS=3
# How many times the CEO may send a deliverable back for revision.
MAX_REVISIONS=1
# Set to 1 to force the offline scripted demo (also used when claude is not installed).
DEMO_MODE=0

# At most this many Claude Code processes run at once (protects your plan's rate limits).
MAX_CONCURRENT_RUNS=4
# A single bot run is stopped after this many minutes.
RUN_TIMEOUT_MINUTES=45
